{
  "schemaVersion": 1,
  "id": "memoryleakfix",
  "version": "${version}",
  "name": "Memory Leak Fix: Continued",
  "description": "Fanmade continuation of Memory Leak Fix for modern Minecraft versions. Fixes multiple memory leaks and lingering references both client-side & server-side.",
  "authors": [
    "TheRealShiroz",
    "FX - PR0CESS"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/memoryleakfix-continued",
    "sources": "https://github.com/ShirozNguyen/MemoryLeakFix-Continued",
    "issues": "https://github.com/ShirozNguyen/MemoryLeakFix-Continued/issues"
  },
  "icon": "icon.png",
  "license": "LGPL-3.0-or-later",
  "environment": "*",
  "entrypoints": {
    "main": [
      "ca.fxco.memoryleakfix.fabric.MemoryLeakFixFabric"
    ]
  },
  "mixins": [
    "${commonMixinId}.mixins.json",
    "memoryleakfix-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0"
  },
  "custom": {
    "mc-publish": {
      "modrinth": "cFBi8ffk",
      "loaders": ["fabric", "quilt"]
    }
  }
